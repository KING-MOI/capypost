{
  "expo": {
    "name": "Capypost",
    "slug": "capypost",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adityaverma.capypost"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-secure-store",
      "expo-web-browser",
      "expo-router",
      "expo-status-bar",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 192, "backgroundColor": "#3EB4E2" }],
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundPlayback": false }],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.adityaverma.capypost",
          "widgets": [
            {
              "name": "Overnight",
              "displayName": "Capypost",
              "description": "Views your posts got while you were away.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "scheme": "capypost"
  }
}
